rules_version = '2';

// Reglas de seguridad de Firestore para Tercer Espacio.
// Ver ARQUITECTURA-FIREBASE.md para la explicación en español llano de
// cada decisión. Aquí solo va la implementación.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(myUid()));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }

    function myRole() {
      return myProfileExists() ? myProfile().role : null;
    }

    function isActive() {
      return myProfileExists() && myProfile().status == "activo";
    }

    function isAdmin() {
      return isActive() && myRole() == "admin";
    }

    function isEditor() {
      return isActive() && myRole() == "editor";
    }

    function isCoop() {
      return isActive() && myRole() == "cooperador";
    }

    function appSettingsExist() {
      return exists(/databases/$(database)/documents/settings/app);
    }

    function appSettings() {
      return get(/databases/$(database)/documents/settings/app).data;
    }

    function coopPerms() {
      let mine = myProfile();
      return ("coopPerms" in mine) ? mine.coopPerms : appSettings().coopPerms;
    }

    // uid del segundo Administrador (además de quien tiene la cuenta
    // original), o null si todavía no se asignó a nadie. Ver la regla
    // de users/{uid} más abajo: nunca puede haber más de dos
    // Administradores en el sistema al mismo tiempo.
    function secondAdminUid() {
      return appSettingsExist() ? appSettings().get('secondAdminUid', null) : null;
    }

    // Verdadero justo cuando el colectivo TODAVÍA no tiene ningún
    // Administrador (proyecto recién creado). Se usa únicamente para
    // permitir que la primera persona que se registra se vuelva admin
    // sin que nadie tenga que aprobarla — porque todavía no hay nadie
    // que pueda hacerlo. En cuanto esa primera cuenta se crea, se marca
    // settings/app.adminBootstrapped = true y esta puerta se cierra para
    // siempre (ver también la regla de settings/app más abajo).
    function noAdminYet() {
      return !appSettingsExist() || appSettings().adminBootstrapped != true;
    }

    // ---------- Usuarios (perfil privado y completo) ----------
    match /users/{uid} {
      // El perfil completo (teléfono, permisos personalizados, estado de
      // sesión, etc.) solo lo puede leer la propia persona o cualquier
      // integrante ya activo (para poder listar "Usuarios", mostrar
      // participantes de eventos, etc.).
      allow read: if isActive() || (isSignedIn() && myUid() == uid);

      allow create: if isSignedIn() && myUid() == uid && (
        // Caso normal: te registras y quedas pendiente de aprobación.
        // Nadie elige su propio rol al registrarse — lo asigna el
        // Administrador cuando acepta la solicitud.
        (request.resource.data.status == "pendiente" && !("role" in request.resource.data))
        ||
        // Caso arranque: el colectivo no tiene ningún Administrador
        // todavía, así que la primera cuenta se activa sola como admin.
        (noAdminYet() && request.resource.data.role == "admin" && request.resource.data.status == "activo")
      );

      allow update: if isAdmin()
                    // el admin puede nombrar como máximo UN Administrador
                    // adicional además de sí mismo: si ya hay uno
                    // asignado (secondAdminUid ocupado por otro uid), no
                    // se puede ascender a nadie más. El resto de los
                    // cambios que puede hacer un admin (incluyendo
                    // degradar a un Administrador existente) no tiene
                    // restricción aquí.
                    ? !(request.resource.data.role == "admin" && resource.data.role != "admin"
                        && secondAdminUid() != null && secondAdminUid() != uid)
                    // cualquier otra persona activa solo puede tocar su
                    // propio perfil (nombre, teléfono, foto) — nunca su
                    // propio rol, estado, permisos de cooperador o el
                    // estado de su sesión (eso lo controla el admin).
                    : (isActive() && myUid() == uid
                       && request.resource.data.role == resource.data.role
                       && request.resource.data.status == resource.data.status
                       && request.resource.data.get('coopPerms', null) == resource.data.get('coopPerms', null)
                       && request.resource.data.get('sessionValid', true) == resource.data.get('sessionValid', true));
      allow delete: if isAdmin() && resource.data.role != "admin";
    }

    // ---------- Directorio público de nombres de usuario ----------
    // Guarda solo lo mínimo para: (1) evitar nombres de usuario
    // duplicados y (2) poder mostrar la vista previa (avatar, nombre,
    // rol) en la pantalla de inicio de sesión ANTES de autenticarse,
    // igual que hacía el prototipo original. No guarda teléfono ni
    // nada más sensible — nada aquí es distinto de lo que cualquiera
    // vería de todas formas al escribir ese nombre de usuario en el
    // login.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == myUid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- Inventario ----------
    match /items/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin() || isEditor() || (isCoop() && coopPerms().invEdit);
      allow delete: if isAdmin() || isEditor() || (isCoop() && coopPerms().invDelete);
    }

    // ---------- Calendario ----------
    match /events/{id} {
      allow read: if isActive();
      allow create, update: if isAdmin() || isEditor() || (isCoop() && coopPerms().calEdit);
      allow delete: if isAdmin() || isEditor() || (isCoop() && coopPerms().calDelete);
    }

    // ---------- Billetera ----------
    match /transactions/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- Pizarra ----------
    match /notes/{id} {
      allow read: if isActive();
      allow create: if isActive();
      allow update, delete: if isAdmin() || (isActive() && resource.data.createdBy == myUid());
    }

    // ---------- Avisos (campana de notificaciones) ----------
    match /avisos/{id} {
      allow read: if isActive()
                  && (resource.data.targetUserId == null || resource.data.targetUserId == myUid());
      allow create: if isActive();
      // solo se permite marcar como visto (agregar el propio uid a seenBy), nada más
      allow update: if isActive()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["seenBy"]);
      allow delete: if false;
    }

    // ---------- Solicitudes de restablecer contraseña ----------
    // Quedan registradas para que el Administrador las vea y las
    // atienda manualmente (ver ARQUITECTURA-FIREBASE.md: no hay forma
    // de restablecer la contraseña de otra persona automáticamente sin
    // un servidor propio). No incluyen contraseña alguna.
    match /passwordResetRequests/{id} {
      allow read: if isAdmin();
      allow create: if true; // se puede pedir sin haber iniciado sesión
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---------- Avisos de servicio al Administrador ----------
    match /serviceNotices/{id} {
      allow read: if isAdmin() || (isActive() && resource.data.userId == myUid());
      allow create: if isActive() && request.resource.data.userId == myUid() && request.resource.data.reply == null;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reply"]);
      allow delete: if false;
    }

    // ---------- Historial de actividad ----------
    match /activityLog/{id} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }

    // ---------- Configuración global ----------
    match /settings/app {
      // debe poder leerse ANTES de iniciar sesión: es lo que muestra si hay modo
      // mantenimiento activo y los textos de las pantallas de login/registro.
      // No contiene nada sensible.
      allow read: if true;
      // Se puede crear una sola vez (con los valores por defecto de
      // fábrica) por cualquier persona que inicie sesión — es lo que
      // arranca un proyecto recién creado, antes de que exista ningún
      // Administrador. En cuanto existe, solo el admin puede tocarla.
      allow create: if isSignedIn() && !appSettingsExist();
      // Nota: justo después de crear su propio users/{uid} con
      // role:"admin" (ver arriba), isAdmin() ya evalúa en verdadero
      // para esa persona en esta siguiente escritura — por eso la
      // cuenta recién nacida en el arranque puede marcar
      // adminBootstrapped:true sin necesitar un caso especial aquí.
      //
      // adminBootstrapped es de una sola vía (una vez true, ningún admin
      // lo puede volver a tocar): si se pudiera desmarcar, se reabriría
      // la puerta de noAdminYet() y cualquier persona que se registrara
      // después podría auto-nombrarse Administrador, sin pasar por el
      // límite de "como máximo un Administrador más" que sí protege la
      // regla de users/{uid} de arriba.
      allow update: if isAdmin()
                    && request.resource.data.get('adminBootstrapped', true) == resource.data.get('adminBootstrapped', true);
    }
  }
}
